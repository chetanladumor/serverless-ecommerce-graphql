{
  "name": "serverless-ecommerce-graphql",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=packages/backend run dev",
    "dev:frontend": "npm --workspace=packages/frontend run dev",
    "build:backend": "npm --workspace=packages/backend run build",
    "build:frontend": "npm --workspace=packages/frontend run build",
    "typecheck": "npm --workspace=packages/backend run typecheck && npm --workspace=packages/frontend run typecheck"
  },
  "keywords": [
    "graphql",
    "apollo-server",
    "apollo-client",
    "aws-lambda",
    "postgresql",
    "prisma",
    "redis",
    "typescript",
    "react"
  ],
  "author": "ChetanKumar Ladumor",
  "license": "ISC"
}
